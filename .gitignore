# ============================================================
# Visual Studio C++ 项目 .gitignore
# 适用于 DataStructure（MSVC v145 / C++20）解决方案
# ============================================================

# ------------------------------
# Visual Studio IDE 元数据
# ------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
monodroid/
monotouch/

# ------------------------------
# 解决方案与项目用户文件
# ------------------------------
*.vcxproj.user
*.vcxproj.filters.user

# ------------------------------
# 构建输出目录（Debug / Release）
# ------------------------------
x64/
x86/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
[Rr]eleasePublic/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ------------------------------
# 编译产物
# ------------------------------
# 目标文件、可执行文件
*.obj
*.iobj
*.exe
*.ilk
*.lib
*.exp
*.pdb
*.ipdb
*.idb

# 预编译头
*.pch
*.ipch
*.iwb

# 临时文件
*.tlog
*.cache
*.lastbuildstate
*.recipe
*.unsuccessfulbuild
*.dt.module.json
*.dt.module.json.command
*.dt.d.json

# ------------------------------
# 性能分析 / 诊断
# ------------------------------
*.psess
*.vsp
*.vspx
*.sap
*.diagsession
*.heapsnapshot

# ------------------------------
# TFS / 版本控制元数据
# ------------------------------
*.vspscc
*.vssscc
*.psess

# ------------------------------
# NuGet（如后续引入包管理）
# ------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# ------------------------------
# 其他系统/编辑器文件
# ------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSSharedFileList

# 编辑器临时/备份
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
